# Copy this file to .env and fill in real values. .env is git-ignored on purpose.

# Comma-separated list of "name:key" pairs. Each calling app gets its own key,
# so you can tell them apart in logs and revoke one without breaking the others.
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=medicalapp:CHANGE_ME_TO_A_RANDOM_SECRET

# Comma-separated list of origins allowed to call this API from a browser (CORS).
# Use your deployed app's real domain(s), e.g. https://my-medical-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Requests allowed per API key, per minute. Tune down if the box struggles.
RATE_LIMIT_PER_MINUTE=20

# Internal Ollama URL — do not change unless you rename the ollama service in docker-compose.yml
OLLAMA_BASE_URL=http://ollama:11434

# Must match the `cpus:` limit set on the ollama service in docker-compose.yml.
# Ollama otherwise auto-detects your machine's full logical core count for its
# thread pool, which oversubscribes against the smaller CPU quota Docker
# actually enforces — causing severe slowdowns from thread contention/throttling.
# Find your own core count with (PowerShell): Get-CimInstance Win32_Processor |
# Select NumberOfLogicalProcessors — then leave a few cores free for the OS.
# The default below (5) is a conservative guess; raise it to match your machine.
OLLAMA_NUM_THREAD=5

# Context window (in tokens) requested from Ollama on every call. Ollama
# defaults to a small window (often 4096) regardless of what the model
# supports, unless told otherwise — this is what actually lets Qwen2.5 use
# its full 32K capacity for multi-week health data. Larger = more RAM for the
# KV cache and slower prompt processing, so tune down if responses get too slow.
OLLAMA_NUM_CTX=16384

# Cloudflare Tunnel token — obtained once from the Cloudflare Zero Trust dashboard.
# See cloudflared/README.md for how to get this. Leave blank and start.ps1 will
# use a free Quick Tunnel instead (no account/domain needed, but the resulting
# *.trycloudflare.com URL changes every restart — fine for testing, not for a
# permanent integration). Set this once you have your own domain.
TUNNEL_TOKEN=
